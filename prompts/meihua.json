{
  "version": "1.0.0",
  "method": "梅花心易・体用法",
  "reading_rules": [
    "体卦・用卦を先に確定する",
    "五行の生剋で吉凶の骨格を決める",
    "変爻がある場合は変卦も参照する",
    "時間卦（時卦）は補助情報として使う",
    "高亨四分類（base.json）で最終断占する"
  ],
  "wuxing_relations": {
    "生": { "label": "相生", "effect": "吉・助力" },
    "剋": { "label": "相剋", "effect": "凶・障害" },
    "比": { "label": "比和", "effect": "中立・現状維持" }
  },
  "output_format": {
    "sections": [
      "【体卦・用卦】",
      "【五行生剋】",
      "【変卦（あれば）】",
      "【結論・断占】",
      "【時期】"
    ]
  }
}
